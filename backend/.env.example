# ============================================================
# 购物决策助手 - 后端环境变量模板
# 复制为 backend/.env 后按需填写。留空的项会走代码默认值/降级逻辑。
# ============================================================

# ---------- 基础 ----------
DEBUG=False
APP_NAME=购物决策助手
APP_VERSION=0.1.0-mvp
API_PREFIX=/api/v1

# CORS：生产必须写具体域名（allow_credentials=True 时不能用 "*"）
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# ---------- 认证（必填）----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=change-this-to-a-random-64-char-string
AUTH_TOKEN_EXPIRE_SECONDS=604800

# ---------- LLM（必填）----------
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 多 key 轮换池（逗号分隔），用于缓解 429
SILICONFLOW_API_KEYS=
ENABLE_REASONING=False
REASONING_MODEL=deepseek-ai/DeepSeek-R1

# ---------- 联网搜索（可选）----------
SERPER_API_KEY=
ENABLE_SEARCH=False

# ---------- 商品联盟数据（选品/价格/佣金必填，留空则商品级数据降级为空）----------
UNION_PROVIDER=haodanku

# 好单库
HAODANKU_API_KEY=
HAODANKU_CID=4

# 大淘客（单品诊断 + 关键词搜索）
DATAOKE_APP_KEY=
DATAOKE_APP_SECRET=
# 淘宝联盟推广位 PID，格式 mm_xxx_xxx_xxx
DATAOKE_PRIVILEGE_PID=

# ---------- 邮箱验证（可选）----------
EMAIL_VERIFY_ENABLED=False
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=True

# ---------- 图形验证码（可选，留空=演示模式）----------
CAPTCHA_PROVIDER=
CAPTCHA_APP_ID=0
CAPTCHA_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=

# ---------- 支付（默认关闭；开启需真实商户资质）----------
PAYMENT_ENABLED=False
PAYMENT_PROVIDER=sandbox
SANDBOX_AUTO_GRANT=False
# 支付宝当面付 / 手机网站支付
ALIPAY_SANDBOX=True
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# ---------- 计费 ----------
# 售价 = 平台成本 × 该倍率
CHARGE_MULTIPLIER=5.0
# 每日免费问答次数（登录/匿名共用同一计数器）
DAILY_FREE_EVENTS=10
# 免费模型白名单（逗号分隔），命中不计费不占额度
FREE_MODELS=deepseek-ai/DeepSeek-V4-Flash
# 商品介绍完全免费（测试期开关）
PRODUCT_INTRO_FREE=True
# 是否允许无凭证直充（生产必须 False）
ALLOW_DIRECT_RECHARGE=False

# ---------- 商户信息（收款码静态资源，自行放置到 app/static/）----------
MERCHANT_NAME=示例科技有限公司
MERCHANT_QR_FILENAME=merchant_qr.jpg

# ---------- 安全 ----------
SSL_VERIFY=True
# 是否把验证码明文打进日志（仅本地调试；生产无效）
DEV_PRINT_CODES=False
